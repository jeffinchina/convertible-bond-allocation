{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["emails"],
  "properties": {
    "emails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "htmlBody",
          "stage",
          "company",
          "code",
          "evidenceUsed",
          "warnings"
        ],
        "properties": {
          "subject": { "type": "string", "minLength": 1 },
          "htmlBody": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "enum": ["registration", "formal"] },
          "company": { "type": "string", "minLength": 1 },
          "code": { "type": "string" },
          "evidenceUsed": {
            "type": "array",
            "items": { "type": "string" }
          },
          "warnings": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
